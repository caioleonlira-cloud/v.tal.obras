rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de autenticação
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Leitura segura do documento do próprio usuário autenticado
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // E-mails de administradores mestres do sistema (insensível a maiúsculas/minúsculas)
    function isSystemAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'caio.lira@telemontrms.com.br' ||
          request.auth.token.email.lower() == 'caioleonlira@gmail.com'
        );
    }

    // Administrador do sistema ou usuário com role == 'ADM'
    function isAdmin() {
      return isSignedIn() && (
        isSystemAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().data.get('role', '') == 'ADM')
      );
    }

    // 1. Coleção de usuários: /users/{uid}
    match /users/{uid} {
      allow get: if isCurrentUser(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if !('password' in request.resource.data) && (
        isAdmin() ||
        (isCurrentUser(uid) &&
          request.resource.data.get('role', '') == 'PADRAO' &&
          request.resource.data.get('status', '') == 'active')
      );

      allow update: if !('password' in request.resource.data) && (
        isAdmin() ||
        (isCurrentUser(uid) &&
          request.resource.data.get('role', '') == resource.data.get('role', '') &&
          request.resource.data.get('status', '') == resource.data.get('status', ''))
      );

      allow delete: if isAdmin();
    }

    // 2. Coleção de registros operacionais de obras
    match /registros/{docId} {
      allow read, write: if isSignedIn();
    }

    // 3. Coleção de registros de faturamento/medição (FR)
    match /fr_registros/{frId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 4. Histórico de auditoria e edições
    match /historico_edicoes/{docId} {
      allow read, write: if isSignedIn();
    }

    // 5. Segmentações e opções dinâmicas
    match /segmentacoes/{docId} {
      allow read, write: if isSignedIn();
    }

    // 6. Sessões de usuários online
    match /online_sessions/{docId} {
      allow read, write: if isSignedIn();
    }

    // 7. Metadados operacionais e de importação
    match /metadata/{docId} {
      allow read, write: if isSignedIn();
    }

    // 8. Configurações gerais do sistema
    match /system_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Bloqueio global por padrão para qualquer outra coleção não declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
