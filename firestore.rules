rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissão global para todas as coleções do sistema
    match /{document=**} {
      allow read, write: if true;
    }

    // Regras explícitas por coleção
    match /registros/{docId} {
      allow read, write: if true;
    }
    match /fr_registros/{docId} {
      allow read, write: if true;
    }
    match /users/{docId} {
      allow read, write: if true;
    }
    match /segmentacoes/{docId} {
      allow read, write: if true;
    }
    match /historico_edicoes/{docId} {
      allow read, write: if true;
    }
    match /online_sessions/{docId} {
      allow read, write: if true;
    }
    match /metadata/{docId} {
      allow read, write: if true;
    }
    match /system_config/{docId} {
      allow read, write: if true;
    }
  }
}


